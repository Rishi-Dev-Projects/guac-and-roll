# ==============================================================================
# Guac N' Roll Cafe — Environment Configuration
# ==============================================================================
#
# Production Site URL (Authoritative Canonical Base URL)
# 
# Development:
#   Leave unset (defaults safely to http://localhost:3000).
#   Preview environments will NOT generate false canonical tags while this is unset.
#
# Production (Vercel Project Settings > Environment Variables):
#   Set this to the verified custom domain once purchased and linked (e.g. https://guacnrollcafe.com).
#   Next.js metadata, sitemap.xml, robots.txt, and JSON-LD will automatically
#   use this authoritative value for search indexing.
#
# IMPORTANT:
#   Do NOT include a trailing slash.
#   Do NOT place credentials, API keys, or private secrets in this file.
# ==============================================================================

NEXT_PUBLIC_SITE_URL=
